# Copy to .env and fill in real values. Never commit .env.

# Gemini API key (powers meal suggestions, grocery substitutes, recipe regeneration)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase project (stores per-user data)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_key_here

# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# USDA FoodData Central (nutrition lookups)
USDA_API_KEY=your_usda_api_key_here

# Session signing secret. Use a long random string, e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-this-to-a-random-secret
